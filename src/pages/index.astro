---
// The site: the drain-the-tide top (TopStory), then PRISM — the specimen hall — as the after
// section. Graduated from /prism on 2026-07-25; the horizon and strata variations are retired.
import Base from '../layouts/Base.astro';
import TopStory from '../components/TopStory.astro';
import Footer from '../components/Footer.astro';
import { ITEMS, sparkPath } from '../lib/items.ts';
import '../styles/prism.css';

const nine = ITEMS.map((it, i) => ({ it, i, spark: sparkPath(it.real, 168, 52) }));
const first = nine[0];
---
<Base>
  <TopStory>
    <section class="nine prism" id="prism">
      <div class="nine-intro measure">
        <h2>Nine things, one at a time.</h2>
        <p class="lede">
          Same lens, nine verdicts. Walk the hall from the best real bargain today to the one that
          ran away.
        </p>
        {/* This line has to say what the hall actually does. It used to promise a vertical
            encoding — "hung off the same line: above it beat inflation's pace" — which stopped
            being true the moment the rule and the lift went. It now names what every number in
            the section means, which on a phone there is no other way to learn. */}
        <p class="meta">
          nine specimens · 1980&ndash;2024 · each % is today's real price measured against its own
          1980 price
        </p>
      </div>

      <div class="pr-scroll" id="prScroll">
        <div class="pr-stage" id="prStage">
          <div class="pr-hall" id="prHall" aria-hidden="true">
            {nine.map(({ it, i }) => (
              <div class="pr-spec" id={`prSpec${i}`} data-i={i} data-far
                   style={`--good:${it.color}; --good-ink:${it.colorInk}`}>
                <figure class="nine-obj">
                  <svg class="nine-mark" viewBox="0 0 120 120"><use href={`#mk-${it.id}`} /></svg>
                </figure>
                {/* the plaque: a specimen you cannot name is a decoration. It rides the same 3D
                    transform as the object, so it reads as part of the exhibit, not an overlay. */}
                <p class="nine-plate pr-plate">{it.label}</p>
              </div>
            ))}
          </div>

          <div class="pr-hud is-on" id="prHud" style={`--good:${first.it.color}; --good-ink:${first.it.colorInk}`}>
            <p class="nine-rank"><span id="prRank">01</span> / 09 · real price today</p>
            <p class="nine-name" id="prName">{first.it.label}</p>
            <p class="nine-pct" id="prPct">{first.it.pct >= 0 ? '+' : '−'}{Math.abs(first.it.pct)}%</p>
            <p class="nine-head" id="prHead">{first.it.head}</p>
            <p class="nine-blurb" id="prBlurb">{first.it.blurb}</p>
            <svg class="nine-spark" id="prSpark" viewBox="0 0 168 52" aria-hidden="true">
              <line class="base" x1="0" y1={first.spark.baseY} x2="168" y2={first.spark.baseY} />
              <path class="ln" d={first.spark.d} />
              <circle class="dot" cx={first.spark.endX} cy={first.spark.endY} r="2.8" />
            </svg>
          </div>

          <p class="pr-railtag" aria-hidden="true">100</p>
          <ol class="pr-rail" id="prRail" aria-hidden="true">
            {nine.map(({ it, i }) => (
              <li data-i={i} data-side={it.rise ? 'up' : 'down'} data-name={it.label}
                  style={`--good:${it.color}; --good-ink:${it.colorInk}; --w:${Math.abs(it.lift).toFixed(3)}`}><i></i></li>
            ))}
          </ol>
          {/* the rail is the only map of the nine and the only way to skip around it — without
              this it reads as chrome and nobody touches it */}
          <p class="pr-raillbl" aria-hidden="true"></p>

          <p class="pr-hint" aria-hidden="true">scroll ↓</p>
        </div>
      </div>

      <ol class="nine-static">
        {nine.map(({ it, i, spark }) => (
          <li style={`--good:${it.color}; --good-ink:${it.colorInk}`}>
            <figure class="nine-obj">
              <svg class="nine-mark" viewBox="0 0 120 120" aria-hidden="true"><use href={`#mk-${it.id}`} /></svg>
            </figure>
            <div>
              <p class="nine-rank">{String(i + 1).padStart(2, '0')} / 09 · real price today</p>
              <p class="nine-name">{it.label}</p>
              <p class="nine-pct">{it.pct >= 0 ? '+' : '−'}{Math.abs(it.pct)}%</p>
              <p class="nine-head">{it.head}</p>
              <p class="nine-blurb">{it.blurb}</p>
              <svg class="nine-spark" viewBox={`0 0 ${spark.W} ${spark.H}`} aria-hidden="true">
                <line class="base" x1="0" y1={spark.baseY} x2={spark.W} y2={spark.baseY} />
                <path class="ln" d={spark.d} />
                <circle class="dot" cx={spark.endX} cy={spark.endY} r="2.8" />
              </svg>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </TopStory>
  <Footer />
  <script>
    import '../scripts/scroll.ts';
    import '../scripts/prism.ts';
  </script>
</Base>
