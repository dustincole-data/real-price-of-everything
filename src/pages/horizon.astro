---
import Base from '../layouts/Base.astro';
import TopStory from '../components/TopStory.astro';
import Footer from '../components/Footer.astro';
import { ITEMS, axisPath, AXIS_MAX } from '../lib/items.ts';
import '../styles/horizon.css';

const BASE_Y = AXIS_MAX - 100; // 280 — index 100 on the top chart's own scale
const panels = ITEMS.map((it, i) => {
  const p = axisPath(it.real);
  return { it, i, p, area: `${p.d} L ${p.endX.toFixed(1)} ${BASE_Y} L ${p.x0.toFixed(1)} ${BASE_Y} Z` };
});
// the docked mini-skyline, same bars and same scale as the top chart's final frame
const SW = 1000, BAR = 1000 / ITEMS.length;
---
<Base>
  <TopStory>
    <section class="nine horizon" id="horizon">
      <div class="nine-intro measure">
        <h2>Nine trajectories, one axis.</h2>
        <p class="lede">
          The staircase, pulled apart. Each thing keeps the same axis you just watched — 100 is
          inflation's own pace — and the glass marks where it landed in 2024.
        </p>
        <p class="meta">nine panels · 1980&ndash;2024 · keep scrolling, the strip pans sideways</p>
      </div>

      <div class="hz-strip">
        <div class="hz-strip-row">
          <span class="hz-strip-tag">all nine, ranked by real price today</span>
          <span class="hz-strip-live" id="hzLive"></span>
        </div>
        <div class="hz-strip-inner">
          <svg class="hz-strip-svg" viewBox={`0 0 ${SW} ${AXIS_MAX}`} preserveAspectRatio="none" aria-hidden="true">
            {panels.map(({ it, i }) => (
              <rect data-i={i} x={i * BAR + BAR * 0.28} width={BAR * 0.44}
                    y={AXIS_MAX - Math.max(2, it.idx)} height={Math.max(2, it.idx)}
                    fill={it.color} fill-opacity="0.9" />
            ))}
            <line class="base" x1="0" y1={BASE_Y} x2={SW} y2={BASE_Y} vector-effect="non-scaling-stroke" />
          </svg>
          <i class="hz-pin" id="hzPin"></i>
        </div>
      </div>

      <div class="hz-scroll" id="hzScroll">
        <div class="hz-stage" id="hzStage">
          <div class="hz-plotbox" aria-hidden="true">
            <span class="hz-baseline"></span>
            <span class="nine-rulelbl hz-baselbl">kept pace with inflation</span>
          </div>

          <div class="hz-track" id="hzTrack">
            {panels.map(({ it, i, p, area }) => (
              <article class="hz-panel" data-i={i}
                       style={`--good:${it.color}; --good-ink:${it.colorInk}; --oy:${p.endYFrac.toFixed(4)}`}>
                <div class="hz-txt">
                  <p class="nine-rank">{String(i + 1).padStart(2, '0')} / 09 · real price today</p>
                  <h3 class="nine-name">{it.label}</h3>
                  <p class="nine-pct" data-target={it.pct}>{it.pct >= 0 ? '+' : '−'}{Math.abs(it.pct)}%</p>
                  <p class="nine-head">{it.head}</p>
                  <p class="nine-blurb">{it.blurb}</p>
                </div>
                <div class="hz-plot">
                  {/* when the strip isn't panning each panel stands alone, so it carries its own
                      copy of the shared 100 line rather than the stage-level one */}
                  <span class="hz-axis-own" data-v="100"
                        style={`top:${(((AXIS_MAX - 100) / AXIS_MAX) * 100).toFixed(3)}%`}></span>
                  <svg class="hz-line" viewBox={`0 0 ${SW} ${AXIS_MAX}`} preserveAspectRatio="none" aria-hidden="true">
                    <path class="area" d={area} />
                    <path class="ln" d={p.d} />
                  </svg>
                  <span class="hz-yr a">{p.startYear}</span>
                  <span class="hz-yr b">2024</span>
                  <figure class="nine-obj hz-fig">
                    {/* eager: a lazy image inside a transformed track can still be blank when its
                        panel slides into frame, and these nine are the content */}
                    <img src={`/obj-light/${it.id}.webp`} srcset={`/obj-light/${it.id}-640.webp 640w, /obj-light/${it.id}.webp 1024w`}
                         sizes="(max-width: 860px) 34vw, 16vw"
                         alt={`${it.label}, as a glass specimen`} width="1024" height="1024"
                         decoding="async" fetchpriority={i < 2 ? 'high' : 'low'} />
                  </figure>
                </div>
              </article>
            ))}
          </div>

          <p class="hz-hint" aria-hidden="true">scroll → pans</p>
        </div>
      </div>

    </section>
  </TopStory>
  <Footer />
  <script>
    import '../scripts/scroll.ts';
    import '../scripts/horizon.ts';
  </script>
</Base>
