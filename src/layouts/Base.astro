---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'The Real Price of Everything',
  description = 'Strip out inflation and everyday prices split. Nine things, one axis, 1980 to today. Scroll to watch them diverge, then guess where each one lands.',
} = Astro.props as Props;
const og = new URL('og/cover.png', Astro.site).href;
const canonical = Astro.site?.href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/libre-franklin-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/spline-sans-mono-400.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <slot />

  <!-- dustincoledata brand mark: last thing on the page, in normal flow. It used to be pinned to
       the viewport, which meant it sat on top of whatever the page put in that corner. -->
  <div class="dcd-footer">
    <a class="dcd-mark" href="https://dustincoledata.com" target="_blank" rel="noopener"
       aria-label="A Dustin Cole Data project">
      <span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span>
    </a>
  </div>
  <style>
    .dcd-footer{display:flex;justify-content:center;
      padding:0 1rem calc(2.25rem + env(safe-area-inset-bottom,0px));}
    /* no longer floating over content, so it drops the blur and the lift-off shadow it needed to
       stay legible there */
    .dcd-mark{display:inline-flex;align-items:baseline;gap:7px;padding:7px 12px;border-radius:999px;
      border:1px solid rgba(22,24,29,.10);
      text-decoration:none;line-height:1;opacity:.85;transition:opacity .2s ease,transform .2s ease;}
    .dcd-mark:hover{opacity:1;transform:translateY(-1px);}
    .dcd-mark:focus-visible{outline:2px solid #4A3AAB;outline-offset:2px;}
    .dcd-mark-name{font-family:'Archivo',-apple-system,'Segoe UI','Helvetica Neue',Arial,sans-serif;
      font-weight:600;font-size:13px;letter-spacing:-.01em;color:#16181D;}
    .dcd-mark-suffix{font-family:ui-monospace,'Cascadia Code','Segoe UI Mono',Menlo,monospace;
      font-weight:500;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#565C68;}
    @media print{.dcd-mark{display:none;}}
    @media (prefers-reduced-motion:reduce){.dcd-mark{transition:none;}}
  </style>
</body>
</html>
